# Copy this file to .env and fill in your own keys. Never commit the real .env file.

# --- Alpaca (paper trading account) ---
# Get these from https://app.alpaca.markets/paper/dashboard/overview
# IMPORTANT: use the keys shown under "Paper Trading", not "Live Trading".
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# --- Financial Modeling Prep (free tier: 250 requests/day) ---
# Get a free key at https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# --- Finnhub (free tier: 60 requests/minute) ---
# Get a free key at https://finnhub.io/register
FINNHUB_API_KEY=

# --- Safety: do not change unless you fully understand the risk ---
# Leave unset. Only set to YES_I_UNDERSTAND if you deliberately want to
# unlock real-money trading (also requires ALPACA_BASE_URL to be the live
# endpoint and a third explicit confirmation flag - see execution/guards.py).
LIVE_TRADING_CONFIRMED=

# --- Budget ---
# Most money the agent will trade, in dollars (0 = whole account). Also set
# the Alpaca paper account balance to this amount (Paper dashboard -> Reset).
SP500_CAPITAL_BUDGET=10000
# With $10K, 30 positions is ~$330 each and many S&P 500 shares cost more
# than that (orders are whole shares). 15 positions gives ~$650 each.
SP500_NUM_POSITIONS=15
SP500_MAX_POSITION_WEIGHT=0.08
