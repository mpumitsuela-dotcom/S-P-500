# Copy to .env for local runs. In the cloud these are GitHub repo secrets.
# Never commit real keys.

# --- Alpaca PAPER account (a separate paper account from the S&P 500 agent) ---
# https://app.alpaca.markets -> switch to the new paper account -> API Keys
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Research sources (all optional; the agent works without them, but with less research) ---
# Finnhub free key (forex news): https://finnhub.io/register
FINNHUB_API_KEY=
# FRED free key (central-bank interest rates): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Anthropic key: Claude reads the news headlines and scores each currency.
# Without it, a simpler keyword scorer is used. Costs roughly $0.50-1 per trading day.
ANTHROPIC_API_KEY=

# --- Risk settings (defaults shown) ---
FX_RISK_PER_TRADE=0.01        # lose at most 1% of the account if a stop is hit
FX_MAX_POSITION_PCT=0.25      # no single ETF above 25% of the account
FX_MAX_POSITIONS=3
FX_DAILY_LOSS_LIMIT=0.03      # stop trading for the day after a 3% loss
FX_ENTRY_THRESHOLD=0.35       # how strong a signal must be to buy (0-1 scale)
